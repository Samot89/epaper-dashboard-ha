# Zkopíruj tento soubor jako "secrets.yaml" do stejné složky (esphome/)
# a doplň vlastní hodnoty. secrets.yaml NIKDY necommituj do gitu
# (je v .gitignore).

wifi_ssid: "TvojeWifiSit"
wifi_password: "TvojeWifiHeslo"

# Heslo záložního přístupového bodu, který se rozjede, pokud se ESP
# nepodaří připojit k WiFi (captive_portal).
ap_fallback_password: "vygeneruj-si-vlastni-heslo"

# Vygeneruj na https://esphome.io/encryption-key (32 bajtů v base64)
api_encryption_key: "vygeneruj-na-esphome.io/encryption-key"
